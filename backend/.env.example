# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://localhost:5432/pspba

# JWT (generate a long random string for production)
JWT_SECRET=your-jwt-secret-change-in-production

# Storage: local backup directory (absolute or relative to backend/)
UPLOAD_DIR=./uploads
LOCAL_BACKUP_DIR=./backups

# Optional: 301 redirect (plateaupeacebuilding.org → pspba.org)
# OLD_DOMAIN=plateaupeacebuilding.org
# NEW_DOMAIN=pspba.org

# Optional: Application email notifications (Story 4.4)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@pspba.org
# STAFF_NOTIFICATION_EMAIL=admin@pspba.org

# Optional: cloud storage (e.g. S3) — add when implementing cloud
# CLOUD_STORAGE_PROVIDER=
# CLOUD_BUCKET=
# CLOUD_REGION=
# CLOUD_ACCESS_KEY=
# CLOUD_SECRET_KEY=
