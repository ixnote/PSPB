# Example nginx config for production: serve frontend (SPA) and proxy /api to backend.
# Copy and adjust server_name, root, proxy_pass. Use with SSL in production.

server {
    listen 80;
    server_name pspba.org www.pspba.org;

    # Frontend (built with npm run build:web → frontend/dist)
    root /var/www/pspba/frontend/dist;
    index index.html;
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API
    location /api {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Optional: 301 from old domain (or do at CDN/edge)
    # server_name plateaupeacebuilding.org;
    # return 301 https://pspba.org$request_uri;
}

# SSL (uncomment and set paths; use certbot or your provider)
# server {
#     listen 443 ssl http2;
#     server_name pspba.org www.pspba.org;
#     ssl_certificate /etc/ssl/certs/pspba.crt;
#     ssl_certificate_key /etc/ssl/private/pspba.key;
#     ... same location blocks as above ...
# }
