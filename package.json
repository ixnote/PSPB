{
  "name": "pspba-kms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PSPBA Knowledge Management System & Website",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=backend",
    "dev:web": "npm run dev --workspace=frontend",
    "build": "npm run build:web",
    "build:api": "npm run build --workspace=backend",
    "build:web": "npm run build --workspace=frontend",
    "start:api": "npm run start --workspace=backend",
    "start:web": "npm run preview --workspace=frontend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "seed:demo": "npm run seed:demo --workspace=backend",
    "health-check": "node scripts/health-check.js",
    "backup": "node scripts/backup-run.js",
    "test": "npm run test --workspace=backend"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
